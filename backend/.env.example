# Copy this file to .env and adjust the values. Never commit .env.
# This example file only holds safe placeholder values, never real secrets.

# Port the API listens on (the frontend's Vite proxy expects 3001)
PORT=3001

# development | production | test
NODE_ENV=development

# debug | info | warn | error | silent
LOG_LEVEL=info

# Where data is stored:
#   memory = simulated sample data in memory (default, resets on restart)
#   sheets = Google Sheets (needs the GOOGLE_* settings, added in Stage 3)
DATA_STORE=memory

# --- Google Sheets (only needed when DATA_STORE=sheets) ---
# Setup guide: docs/google-sheets-setup.md
# The spreadsheet ID from its URL: https://docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
# "client_email" from the JSON key file (ends with .iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# "private_key" from the JSON key file, on ONE line, in double quotes, \n kept as written:
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=

# --- Gemini AI (optional: without a key, AI qualification is off and leads stay "pending") ---
# Get a key at https://aistudio.google.com → "Get API key". SECRET: never commit or share it.
GEMINI_API_KEY=
# Optional. Leave empty for the default. "npm run ai:check" lists the models your key can use.
GEMINI_MODEL=

# Business name used to sign AI follow-up drafts. Default: "LeadPilot Demo Contracting" (fictional)
CONTRACTOR_NAME=

# --- n8n automation (Stage 6, optional: without these, automation is off) ---
# Setup guide: automation/documentation/n8n-setup.md
# Shared secret between the backend and n8n (at least 32 characters). SECRET: never commit or share it.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTOMATION_SECRET=
# Where n8n's Webhook nodes listen. Local n8n: http://localhost:5678/webhook
# Leave empty to let n8n call the backend without the backend sending events to n8n.
N8N_WEBHOOK_BASE_URL=

# --- Security (Stage 8) ---
# How many proxies are in front of this server (for rate limits per visitor IP).
# Empty locally. On Vercel / behind one load balancer: 1. Never more than really exist.
TRUST_PROXY=
