{
  "name": "leadpilot-backend",
  "version": "0.1.0",
  "description": "REST API for the AI Lead Management & Self-Healing Automation Platform",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "start": "node --env-file-if-exists=.env server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.js",
    "sheets:check": "node --env-file-if-exists=.env scripts/sheets.js check",
    "sheets:setup": "node --env-file-if-exists=.env scripts/sheets.js setup",
    "ai:check": "node --env-file-if-exists=.env scripts/ai.js check",
    "ai:eval": "node --env-file-if-exists=.env scripts/ai.js eval",
    "ai:eval-followup": "node --env-file-if-exists=.env scripts/ai.js eval-followup",
    "auth:set-password": "node scripts/auth.js set-password",
    "keys:import-google": "node scripts/keys.js import-google",
    "keys:set-gemini": "node scripts/keys.js set-gemini"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@googleapis/sheets": "^18.1.2",
    "@vercel/functions": "^3.11.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1",
    "vitest": "^5.1.0"
  }
}
