# Dependencies (rebuilt with npm install)
node_modules/

# Build output
dist/
dist-ssr/

# Secrets - NEVER commit these
.env
.env.*
!.env.example

# Logs
*.log

# OS / editor files
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea

# Google service account key files - NEVER commit these
# (keep the downloaded JSON key OUTSIDE the project folder anyway)
*service-account*.json
*credentials*.json
*-key.json

# AI eval output that changes on every run (named copies like run-3-*.json ARE committed)
backend/evals/last-run.json
backend/evals/followup-last-run.json

# Stage 8: a generated staff password file (delete it after reading). NEVER commit.
STAFF-PASSWORD.txt

# Stage 9: local backups of the Google Sheet (contain customer data). NEVER commit.
backups/

.vercel
.env*.local
